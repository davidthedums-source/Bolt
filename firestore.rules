rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['davidthedums@gmail.com', 'boltcybercafe@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Ticket validation helper
    function isValidTicket(data) {
      return data.keys().hasAll(['trackingCode', 'customerName', 'customerPhone', 'serviceCategory', 'status']) &&
        data.trackingCode is string && data.trackingCode.size() > 0 && data.trackingCode.size() <= 32 &&
        data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100 &&
        data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 30 &&
        data.serviceCategory is string && data.serviceCategory.size() > 0 && data.serviceCategory.size() <= 100 &&
        data.status in ['submitted', 'diagnosing', 'in-progress', 'testing', 'ready', 'completed', 'cancelled'] &&
        (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 150)) &&
        (!('deviceType' in data) || (data.deviceType is string && data.deviceType.size() <= 50)) &&
        (!('deviceModel' in data) || (data.deviceModel is string && data.deviceModel.size() <= 100)) &&
        (!('issueDescription' in data) || (data.issueDescription is string && data.issueDescription.size() <= 2000)) &&
        (!('urgency' in data) || (data.urgency in ['standard', 'express', 'urgent'])) &&
        (!('technicianNotes' in data) || (data.technicianNotes is string && data.technicianNotes.size() <= 2000)) &&
        (!('estimatedCost' in data) || (data.estimatedCost is string && data.estimatedCost.size() <= 50)) &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Contact message validation helper
    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'status']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 3000 &&
        data.status in ['unread', 'replied', 'archived'] &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('subject' in data) || (data.subject is string && data.subject.size() <= 150)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // User profile validation helper
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
        data.role in ['customer', 'admin'] &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Repair & Service Tickets
    match /tickets/{ticketId} {
      allow get: if isValidId(ticketId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(ticketId) && isValidTicket(incoming());
      allow update: if isValidId(ticketId) && isValidTicket(incoming()) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == resource.data.userId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['issueDescription', 'customerPhone', 'customerEmail', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    // Contact Inquiries
    match /contact_messages/{messageId} {
      allow create: if isValidId(messageId) && isValidContactMessage(incoming());
      allow get, list, update, delete: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) &&
                    (incoming().role == 'customer' || (request.auth.token.email in ['davidthedums@gmail.com', 'boltcybercafe@gmail.com'] && incoming().role == 'admin'));
      allow update: if isSignedIn() && isValidUser(incoming()) && (
        isAdmin() ||
        (request.auth.uid == userId && incoming().role == existing().role &&
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phone', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    // Connection test document
    match /test/connection {
      allow get: if true;
    }
  }
}
